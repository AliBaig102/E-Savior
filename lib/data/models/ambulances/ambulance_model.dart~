import 'package:cloud_firestore/cloud_firestore.dart';
import '../drivers/driver_model.dart';

class AmbulanceModel {
  final String id;
  final String hospital;
  final String driverId;
  final String status;
  final String type;
  final Timestamp createdAt;
  final Timestamp updatedAt;
  DriverModel? driver; // Optional property to hold the associated driver

  AmbulanceModel({
    required this.id,
    required this.hospital,
    required this.driverId,
    required this.status,
    required this.type,
    required this.createdAt,
    required this.updatedAt,
    this.driver, // Optional driver property
  });

  factory AmbulanceModel.fromMap(Map<String, dynamic> data, String documentId) {
    return AmbulanceModel(
      id: documentId,
      hospital: data['hospital'] ?? '',
      driverId: data['driverId'] ?? '',
      status: data['status'] ?? '',
      type: data['type'] ?? '',
      createdAt: data['createdAt'],
      updatedAt: data['updatedAt'],
    );
  }

  Map<String, dynamic> toMap() {
    return {
      'hospital': hospital,
      'driverId': driverId,
      'status': status,
      'type': type,
      'createdAt': createdAt,
      'updatedAt': updatedAt,
    };
  }
}